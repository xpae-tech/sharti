# All variables below are read by the backend. Copy this file to `.env`;
# the backend loads it from the project root automatically.

# Path to Splash runtime root (directory containing install/launcher.py)
SHARTI_SPLASH_RUNTIME=

# Ports
SHARTI_BACKEND_PORT=3000
SHARTI_FRONTEND_PORT=5173

# Runtime data directory (defaults to ./data next to project root;
# set this for packaged/deployed installs to keep state outside the app dir)
SHARTI_DATA_DIR=

# Optional: API key passed to the Splash engine when the UI has none
SPLASH_API_KEY=

# Optional: override the static frontend directory (defaults to dist/frontend if built)
SHARTI_FRONTEND_DIR=

# Optional: extra browser origins allowed to call the local API (comma separated)
SHARTI_ALLOWED_ORIGINS=
