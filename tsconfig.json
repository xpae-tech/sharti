{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "paths": {
      "~/*": ["./backend/src/*"]
    },
    "types": ["node"]
  },
  "include": ["shared/**/*.ts", "backend/src/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "frontend"]
}
